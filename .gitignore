# openCenter AirGap .gitignore

# Build artifacts (ignore build output directory, not scripts/build/)
dist/
*.tar
*.tar.gz
*.tar.zst
*.tar.bz2
*.tar.xz
*.tgz

# kubespray-offline outputs
outputs/

# Downloaded assets (keep directory structure, ignore binaries)
assets/

# Terraform
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup
*.tfvars

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.env
ENV/
.venv
.hypothesis

# Testing
.pytest_cache/
.coverage
htmlcov/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Secrets
*.key
*.pem
*.crt
secrets/
credentials/
.secrets/

# Temporary files
tmp/
temp/
*.tmp

# Zarf
zarf-sbom/
zarf-package-*.tar.zst
checksums.txt
testdata/
test-data

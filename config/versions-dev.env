# openCenter AirGap Development Version Configuration
# This file uses latest development versions for testing and development
# WARNING: Not for production use - versions may be unstable

# Kubespray and Kubernetes versions
# Using master branch for latest development
KUBESPRAY_VERSION="master"
KUBESPRAY_COMMIT_SHA="HEAD"  # pragma: allowlist secret
KUBERNETES_VERSION="v1.34.3"

# Target OS
UBUNTU_VERSION="24.04"

# Container runtime and CNI (latest stable)
CONTAINER_RUNTIME="containerd"
CONTAINERD_VERSION="2.1.5"
RUNC_VERSION="1.3.4"
CNI_VERSION="1.8.0"
CNI_PLUGIN="calico"
CALICO_VERSION="3.27.0"

# Terraform version (latest stable)
TERRAFORM_VERSION="1.10.3"

# Core Services Versions (latest stable releases)
FLUXCD_VERSION="v2.4.0"
GITEA_VERSION="1.22.6"
CERT_MANAGER_VERSION="v1.16.2"
INGRESS_NGINX_VERSION="v1.12.0"
KEYCLOAK_VERSION="26.0.7"
PROMETHEUS_VERSION="v3.0.1"
GRAFANA_VERSION="11.4.0"

# openCenter GitOps (development branch)
OPENCENTER_GITOPS_BASE_REPO="https://github.com/rackerlabs/openCenter-gitops-base"
OPENCENTER_GITOPS_BASE_VERSION="main"
OPENCENTER_GITOPS_BASE_COMMIT_SHA="HEAD"  # pragma: allowlist secret

# Genestack (development branch)
GENESTACK_REPO="https://github.com/rackerlabs/genestack"
GENESTACK_VERSION="main"
GENESTACK_COMMIT_SHA="HEAD"  # pragma: allowlist secret

# RMPK Environments
RMPK_ENVIRONMENTS="https://github.com/rpc-environments/"

# openCenter Container Registry
OPENCENTER_CONTAINER_REGISTRY="ghcr.io/opencenter-cloud"

# Build configuration
SKIP_HARBOR="true"  # Zarf provides registry:2
SKIP_NGINX="false"  # Use minimal nginx:alpine for file serving

# Operator Tools (latest stable)
K9S_VERSION="v0.32.7"
HELM_VERSION="v3.16.3"
STERN_VERSION="v1.31.0"
KUBECTX_VERSION="v0.9.5"
KUBECTL_VERSION="v1.34.3"

# Additional CLI Tools
YQ_VERSION="v4.44.6"
JQ_VERSION="1.7.1"

# Terraform Providers (latest stable)
OPENSTACK_PROVIDER_VERSION="2.1.0"
LOCAL_PROVIDER_VERSION="2.5.2"
NULL_PROVIDER_VERSION="3.2.3"
RANDOM_PROVIDER_VERSION="3.6.3"
TLS_PROVIDER_VERSION="4.0.6"

# Container Images (latest stable)
REGISTRY_VERSION="2.8.3"
NGINX_VERSION="1.27.3"

# Architecture
TARGET_ARCH="amd64"
PYTHON_VERSION="3.10"

# Development flags
DEV_MODE="true"
ENABLE_DEBUG_LOGGING="true"
SKIP_IMAGE_VALIDATION="false"
ALLOW_UNSIGNED_PACKAGES="false"

# Git configuration for development
GIT_SHALLOW_CLONE="false"  # Full clone for development
GIT_CLONE_DEPTH="0"  # Unlimited depth


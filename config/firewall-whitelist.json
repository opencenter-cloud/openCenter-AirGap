{
  "name": "openCenter AirGap Build Firewall Whitelist",
  "version": "1.0.0",
  "description": "Complete list of URLs required for building openCenter AirGap package",
  "last_updated": "2026-01-26",
  "categories": {
    "container_registries": {
      "description": "Container image registries",
      "urls": [
        "registry.k8s.io",
        "k8s.gcr.io",
        "gcr.io",
        "ghcr.io",
        "docker.io",
        "registry-1.docker.io",
        "index.docker.io",5
        "auth.docker.io",
        "production.cloudflare.docker.com",
        "quay.io",
        "grafana.com",
        "docker.grafana.com",
        "goharbor.io",
        "bitnami.com",
        "registry.opensource.zalan.do"
      ],
      "ports": [443],
      "protocols": ["https"]
    },
    "git_repositories": {
      "description": "Git repository hosting",
      "urls": [
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "codeload.github.com"
      ],
      "ports": [443, 9418],
      "protocols": ["https", "git"]
    },
    "kubernetes_binaries": {
      "description": "Kubernetes binary downloads",
      "urls": [
        "dl.k8s.io",
        "storage.googleapis.com"
      ],
      "ports": [443],
      "protocols": ["https"]
    },
    "python_packages": {
      "description": "Python Package Index (PyPI)",
      "urls": [
        "pypi.org",
        "pypi.python.org",
        "files.pythonhosted.org"
      ],
      "ports": [443],
      "protocols": ["https"]
    },
    "system_packages": {
      "description": "Ubuntu/Debian package repositories",
      "urls": [
        "archive.ubuntu.com",
        "security.ubuntu.com",
        "ports.ubuntu.com",
        "us.archive.ubuntu.com",
        "mirror.ubuntu.com"
      ],
      "ports": [80, 443],
      "protocols": ["http", "https"]
    },
    "terraform": {
      "description": "Terraform and provider downloads",
      "urls": [
        "releases.hashicorp.com",
        "registry.terraform.io",
        "checkpoint-api.hashicorp.com"
      ],
      "ports": [443],
      "protocols": ["https"]
    },
    "zarf": {
      "description": "Zarf packaging tool",
      "urls": [
        "get.zarf.dev"
      ],
      "ports": [443],
      "protocols": ["https"]
    },
    "cdn_and_support": {
      "description": "CDN and certificate validation",
      "urls": [
        "cloudflare.com",
        "fastly.com",
        "akamai.com",
        "googleapis.com",
        "letsencrypt.org",
        "ocsp.digicert.com",
        "ocsp.sectigo.com",
        "ocsp.godaddy.com"
      ],
      "ports": [80, 443],
      "protocols": ["http", "https"]
    }
  },
  "wildcard_rules": {
    "description": "Simplified wildcard rules for easier configuration",
    "domains": [
      "*.gcr.io",
      "*.docker.io",
      "*.docker.com",
      "*.quay.io",
      "*.k8s.io",
      "*.ghcr.io",
      "*.grafana.com",
      "*.goharbor.io",
      "*.github.com",
      "*.githubusercontent.com",
      "*.googleapis.com",
      "*.google.com",
      "*.hashicorp.com",
      "*.python.org",
      "*.pythonhosted.org",
      "*.ubuntu.com",
      "*.cloudflare.com",
      "*.fastly.com",
      "*.akamai.com"
    ]
  },
  "required_ports": {
    "tcp": [80, 443, 9418],
    "udp": [53]
  },
  "dns_requirements": {
    "description": "DNS resolution required for all hostnames",
    "port": 53,
    "protocols": ["udp", "tcp"]
  },
  "proxy_configuration": {
    "environment_variables": [
      "HTTP_PROXY",
      "HTTPS_PROXY",
      "NO_PROXY"
    ],
    "no_proxy_defaults": [
      "localhost",
      "127.0.0.1",
      ".local"
    ]
  },
  "verification": {
    "test_urls": [
      "https://registry.k8s.io",
      "https://gcr.io",
      "https://ghcr.io",
      "https://docker.io",
      "https://quay.io",
      "https://github.com",
      "https://dl.k8s.io",
      "https://pypi.org",
      "https://archive.ubuntu.com",
      "https://releases.hashicorp.com",
      "https://registry.terraform.io"
    ]
  },
  "notes": [
    "All URLs require HTTPS (port 443) unless otherwise specified",
    "DNS resolution (UDP/TCP port 53) is required for all hostnames",
    "Git protocol (port 9418) is optional if using HTTPS for git",
    "HTTP (port 80) may redirect to HTTPS for some services",
    "Wildcard rules simplify configuration but may be overly permissive",
    "IP-based rules are not recommended due to frequent changes",
    "Certificate validation requires OCSP endpoints to be accessible"
  ]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencenter.io/schemas/versions.schema.json",
  "title": "openCenter AirGap Version Configuration",
  "description": "Version pins for all components in the air-gap package",
  "type": "object",
  "required": [
    "KUBERNETES_VERSION",
    "TERRAFORM_VERSION",
    "KUBESPRAY_VERSION",
    "KUBESPRAY_COMMIT_SHA",
    "UBUNTU_VERSION",
    "CONTAINER_RUNTIME",
    "CNI_PLUGIN",
    "OPENCENTER_GITOPS_BASE_COMMIT_SHA"
  ],
  "properties": {
    "KUBESPRAY_VERSION": {
      "type": "string",
      "description": "Kubespray version tag or branch",
      "examples": ["v2.24.0", "master"]
    },
    "KUBERNETES_VERSION": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Kubernetes semantic version with 'v' prefix",
      "examples": ["v1.34.3"]
    },
    "UBUNTU_VERSION": {
      "type": "string",
      "pattern": "^[0-9]{2}\\.[0-9]{2}$",
      "description": "Ubuntu LTS version (YY.MM format)",
      "examples": ["24.04", "22.04"]
    },
    "CONTAINER_RUNTIME": {
      "type": "string",
      "enum": ["containerd", "crio"],
      "description": "Container runtime for Kubernetes"
    },
    "CNI_PLUGIN": {
      "type": "string",
      "enum": ["calico", "cilium", "flannel"],
      "description": "CNI plugin for pod networking"
    },
    "TERRAFORM_VERSION": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Terraform version (semantic version without 'v' prefix)",
      "examples": ["1.6.6"]
    },
    "FLUXCD_VERSION": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "FluxCD version",
      "examples": ["v2.2.0"]
    },
    "GITEA_VERSION": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Gitea version",
      "examples": ["1.21.0"]
    },
    "CERT_MANAGER_VERSION": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "cert-manager version",
      "examples": ["v1.13.0"]
    },
    "INGRESS_NGINX_VERSION": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "ingress-nginx version",
      "examples": ["v1.9.0"]
    },
    "KEYCLOAK_VERSION": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Keycloak version",
      "examples": ["21.1.1"]
    },
    "PROMETHEUS_VERSION": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Prometheus version",
      "examples": ["v2.48.0"]
    },
    "GRAFANA_VERSION": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Grafana version",
      "examples": ["10.2.0"]
    },
    "OPENCENTER_GITOPS_BASE_REPO": {
      "type": "string",
      "format": "uri",
      "description": "Git repository URL for openCenter GitOps base"
    },
    "OPENCENTER_GITOPS_BASE_VERSION": {
      "type": "string",
      "description": "Git tag, branch, or commit SHA for GitOps base",
      "examples": ["main", "v1.0.0", "abc123def456"]
    },
    "OPENCENTER_GITOPS_BASE_COMMIT_SHA": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Full 40-character commit SHA for GitOps base (supply chain security)"
    },
    "KUBESPRAY_COMMIT_SHA": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Full 40-character commit SHA for Kubespray (supply chain security)"
    },
    "RMPK_ENVIRONMENTS": {
      "type": "string",
      "format": "uri",
      "description": "Base URL for RMPK environment repositories"
    },
    "OPENCENTER_CONTAINER_REGISTRY": {
      "type": "string",
      "description": "Container registry for openCenter images",
      "examples": ["ghcr.io/opencenter-cloud"]
    },
    "SKIP_HARBOR": {
      "type": "string",
      "enum": ["true", "false"],
      "description": "Skip Harbor deployment (use Zarf registry instead)"
    },
    "SKIP_NGINX": {
      "type": "string",
      "enum": ["true", "false"],
      "description": "Skip nginx deployment for file serving"
    },
    "K9S_VERSION": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "k9s CLI version"
    },
    "HELM_VERSION": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Helm CLI version"
    },
    "STERN_VERSION": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Stern log viewer version"
    },
    "KUBECTX_VERSION": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "kubectx/kubens version"
    },
    "OPENSTACK_PROVIDER_VERSION": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Terraform OpenStack provider version"
    },
    "LOCAL_PROVIDER_VERSION": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Terraform local provider version"
    },
    "NULL_PROVIDER_VERSION": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Terraform null provider version"
    },
    "RANDOM_PROVIDER_VERSION": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Terraform random provider version"
    },
    "TLS_PROVIDER_VERSION": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Terraform TLS provider version"
    },
    "TARGET_ARCH": {
      "type": "string",
      "enum": ["amd64", "arm64"],
      "description": "Target CPU architecture"
    },
    "PYTHON_VERSION": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Python version (major.minor)",
      "examples": ["3.10", "3.11"]
    }
  },
  "additionalProperties": true
}

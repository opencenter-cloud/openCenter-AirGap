{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencenter.io/schemas/nodes.schema.json",
  "title": "Kubernetes Node Inventory",
  "description": "Node definitions for Kubespray cluster deployment",
  "type": "object",
  "required": ["control_plane", "workers"],
  "properties": {
    "control_plane": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "description": "Control plane nodes (odd number recommended for etcd quorum)",
      "items": {
        "type": "object",
        "required": ["hostname", "ip"],
        "properties": {
          "hostname": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
            "description": "DNS-compliant hostname (RFC 1123)"
          },
          "ip": {
            "type": "string",
            "description": "Node IP address (IPv4 or IPv6)"
          },
          "ansible_host": {
            "type": "string",
            "description": "SSH target IP (if different from cluster IP, e.g., jump host)"
          },
          "ssh_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 22,
            "description": "SSH port"
          },
          "ansible_user": {
            "type": "string",
            "description": "SSH user for Ansible connection"
          }
        },
        "additionalProperties": false
      }
    },
    "workers": {
      "type": "array",
      "minItems": 0,
      "description": "Worker nodes for application workloads",
      "items": {
        "type": "object",
        "required": ["hostname", "ip"],
        "properties": {
          "hostname": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
            "description": "DNS-compliant hostname (RFC 1123)"
          },
          "ip": {
            "type": "string",
            "description": "Node IP address (IPv4 or IPv6)"
          },
          "ansible_host": {
            "type": "string",
            "description": "SSH target IP (if different from cluster IP)"
          },
          "ssh_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 22,
            "description": "SSH port"
          },
          "ansible_user": {
            "type": "string",
            "description": "SSH user for Ansible connection"
          },
          "node_labels": {
            "type": "object",
            "description": "Kubernetes node labels",
            "additionalProperties": {
              "type": "string"
            }
          },
          "node_taints": {
            "type": "array",
            "description": "Kubernetes node taints",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9A-Z._/-]+=?[a-z0-9A-Z._-]*:(NoSchedule|PreferNoSchedule|NoExecute)$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "etcd": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "description": "Dedicated etcd nodes (optional, defaults to control_plane)",
      "items": {
        "type": "object",
        "required": ["hostname", "ip"],
        "properties": {
          "hostname": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
            "description": "DNS-compliant hostname"
          },
          "ip": {
            "type": "string",
            "description": "Node IP address (IPv4 or IPv6)"
          },
          "ansible_host": {
            "type": "string",
            "description": "SSH target IP"
          },
          "ssh_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 22
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

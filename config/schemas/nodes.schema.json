{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["control_plane"],
  "properties": {
    "control_plane": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "workers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["hostname", "ip"],
      "properties": {
        "hostname": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "ip": {
          "type": "string"
        },
        "ssh_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "ansible_host": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "taints": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}

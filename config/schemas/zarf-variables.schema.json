{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "install_path": {
      "type": "string",
      "pattern": "^/"
    },
    "registry_host": {
      "type": "string"
    },
    "registry_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "cluster_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "pod_network_cidr": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+$"
    },
    "enable_metrics_server": {
      "type": "boolean"
    },
    "enable_ingress": {
      "type": "boolean"
    },
    "enable_cert_manager": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}

# openCenter AirGap Version Configuration
# This file defines all version pins for reproducible builds

# Kubespray and Kubernetes versions
# IMPORTANT: Use specific tags, not mutable references (master, main)
# TODO: Update KUBESPRAY_COMMIT_SHA with actual SHA from: git ls-remote https://github.com/kubernetes-sigs/kubespray.git refs/tags/v2.24.0
KUBESPRAY_VERSION="v2.24.0"
KUBESPRAY_COMMIT_SHA="8a5d3d0c8e9f7b6a5c4d3e2f1a0b9c8d7e6f5a4b"  # pragma: allowlist secret
KUBERNETES_VERSION="v1.34.3"

# Target OS
UBUNTU_VERSION="24.04"

# Container runtime and CNI
CONTAINER_RUNTIME="containerd"
CNI_PLUGIN="calico"

# Terraform version (for OpenStack deployments)
TERRAFORM_VERSION="1.6.6"

# Core Services Versions
FLUXCD_VERSION="v2.2.0"
GITEA_VERSION="1.21.0"
CERT_MANAGER_VERSION="v1.13.0"
INGRESS_NGINX_VERSION="v1.9.0"
KEYCLOAK_VERSION="21.1.1"
PROMETHEUS_VERSION="v2.48.0"
GRAFANA_VERSION="10.2.0"

# openCenter GitOps
# IMPORTANT: Use specific tags or commit SHAs, not mutable references (main, master)
# TODO: Update with actual tag and SHA from: git ls-remote https://github.com/rackerlabs/openCenter-gitops-base
OPENCENTER_GITOPS_BASE_REPO="https://github.com/rackerlabs/openCenter-gitops-base"
OPENCENTER_GITOPS_BASE_VERSION="v1.0.0"
OPENCENTER_GITOPS_BASE_COMMIT_SHA="1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b"  # pragma: allowlist secret

# RMPK Environments
RMPK_ENVIRONMENTS="https://github.com/rpc-environments/"

# openCenter Container Registry
OPENCENTER_CONTAINER_REGISTRY="ghcr.io/opencenter-cloud"

# Build configuration
SKIP_HARBOR="true"  # Zarf provides registry:2
SKIP_NGINX="false"  # Use minimal nginx:alpine for file serving

# Operator Tools
K9S_VERSION="v0.32.5"
HELM_VERSION="v3.14.0"
STERN_VERSION="v1.28.0"
KUBECTX_VERSION="v0.9.5"

# Terraform Providers
OPENSTACK_PROVIDER_VERSION="1.54.1"
LOCAL_PROVIDER_VERSION="2.4.1"
NULL_PROVIDER_VERSION="3.2.2"
RANDOM_PROVIDER_VERSION="3.6.0"
TLS_PROVIDER_VERSION="4.0.5"

# Architecture
TARGET_ARCH="amd64"
PYTHON_VERSION="3.10"
